# Database
DATABASE_URL=postgresql+psycopg://apm:apm_dev_password@localhost:5433/apm_dev

# Redis (Celery broker/result backend, caching, rate limiting)
REDIS_URL=redis://localhost:6380/0

# Auth
JWT_SECRET_KEY=change-me-in-production-use-a-random-32-plus-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
MAGIC_LINK_EXPIRE_MINUTES=30

# Storage (local filesystem for Phase 1 — see storage abstraction)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=../../uploads

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
