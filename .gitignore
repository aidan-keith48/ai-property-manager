# Uploads (local filesystem storage for Phase 1)
uploads/*
!uploads/.gitkeep

# Python (scoped to apps/api — unanchored patterns like lib/ would
# otherwise also match unrelated dirs elsewhere in the monorepo, e.g.
# apps/web/lib/)
apps/api/__pycache__/
apps/api/**/__pycache__/
apps/api/*.py[cod]
apps/api/.Python
apps/api/build/
apps/api/dist/
apps/api/lib/
apps/api/lib64/
apps/api/parts/
apps/api/sdist/
apps/api/var/
apps/api/wheels/
apps/api/*.egg-info/
apps/api/*.egg
apps/api/env/
apps/api/venv/
apps/api/.venv
apps/api/.pytest_cache/
apps/api/.ruff_cache/
apps/api/.coverage
apps/api/htmlcov/

# Node
node_modules/
.next/
out/
.turbo/

# IDE — settings.json is committed on purpose: it carries the Start/Stop
# action buttons, which are part of how you run this project.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Local Claude Code tool state (not part of the app)
.claude/

# Playwright e2e artifacts
apps/web/test-results/
apps/web/playwright-report/

# Environment
.env
.env.local
.env.*.local

# Docker
.env.docker
docker-compose.override.yml

# Celery
celerybeat-schedule

# Local dev server logs (scripts/dev-start.sh)
.dev-logs/
